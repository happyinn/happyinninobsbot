<?xml version="1.0" encoding="utf-8"?>
<!-- 播放速度调整布局文件 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 速度增减控制栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- 减速按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/dec_speed"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_remove" />

        <!-- 当前播放速度显示文本 -->
        <TextView
            android:id="@+id/speed_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

        <!-- 加速按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/inc_speed"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_add" />

    </LinearLayout>

    <!-- 速度滑块控制区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <!-- 播放速度滑块，范围0.2x到4.0x，步长0.1x -->
        <com.google.android.material.slider.Slider
            android:id="@+id/speed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:stepSize="0.1"
            android:theme="@style/Widget.Material3.Slider"
            android:value="1.0"
            android:valueFrom="0.2"
            android:valueTo="4.0"
            app:labelBehavior="gone" />

        <!-- 重置速度按钮，恢复到1.0x -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reset_speed"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="5dp"
            app:icon="@drawable/ic_reset" />
    </LinearLayout>

    <!-- 常用速度按钮水平滚动区 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- 0.2x速度按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_0.2x"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="0.2x" />

            <!-- 0.5x速度按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_0.5x"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="5dp"
                android:text="0.5x" />

            <!-- 1.0x速度按钮（正常速度） -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_1.0x"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="5dp"
                android:text="1.0x" />

            <!-- 1.5x速度按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_1.5x"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="5dp"
                android:text="1.5x" />

            <!-- 2.0x速度按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_2.0x"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="5dp"
                android:text="2.0x" />

            <!-- 2.5x速度按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_2.5x"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="5dp"
                android:text="2.5x" />

            <!-- 3.0x速度按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_3.0x"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="5dp"
                android:text="3.0x" />

            <!-- 3.5x速度按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_3.5x"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="5dp"
                android:text="3.5x" />

            <!-- 4.0x速度按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_4.0x"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="5dp"
                android:text="4.0x" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- 跳过静音开关控制区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <!-- 跳过静音部分开关 -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/skip_silence"
            style="@style/Widget.Material3.CompoundButton.MaterialSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/skip_silence" />
    </LinearLayout>
</LinearLayout>
